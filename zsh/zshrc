export ZSH="$HOME/.oh-my-zsh"
export LANG=en_US.UTF-8
export TERM=xterm-256color
export FUNCNEST=100

# Homebrew first: ahead of ~/.local/bin, /usr/local/bin and macOS /usr/bin (/etc/paths puts system dirs first)
typeset -U path
path=(/opt/homebrew/bin /opt/homebrew/sbin "$HOME/.local/bin" $path)

autoload -Uz compinit && compinit
zstyle ':completion:*' use-cache on

##>> CONFIG ZSH BASIC -----------------------------
HIST_STAMPS="YYYY/MM/DD"
HYPHEN_INSENSITIVE="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"

##>> HISTORY CONFIG -----------------------------
HISTFILE=~/.zsh_history
HISTSIZE=1000
SAVEHIST=10000
setopt appendhistory

##>> IMPORT MY OWN FILE CONFIGURATION ------------------
for file in ~/.config/zsh/*.sh; do
  source "$file"
done

#>> PLUGINS AND PLUGIN MANAGER ------------------------
[ -f "$HOME/.local/share/zap/zap.zsh" ] && source "$HOME/.local/share/zap/zap.zsh" ||
  zsh <(curl -s https://raw.githubusercontent.com/zap-zsh/zap/master/install.zsh) --branch release-v1

if [[ $(which plug) ]]; then
  plug "agkozak/zsh-z"
  plug "Aloxaf/fzf-tab"
  plug "hlissner/zsh-autopair"
  plug "zsh-users/zsh-autosuggestions"
  plug "zdharma-continuum/fast-syntax-highlighting"
  # plug "jeffreytse/zsh-vi-mode"
fi

#>> THEME   ---------------------------------------------------------------
eval "$(starship init zsh)"

# fnm
eval "$(fnm env --use-on-cd)"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# Hermes Orchestrator session with only the tools it uses (~17K fixed tokens instead of ~24K)
alias orch='hermes --tui -t terminal,file,skills,clarify,delegation,vision,todo'
